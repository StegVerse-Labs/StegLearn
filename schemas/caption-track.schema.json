{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/StegLearn/schemas/caption-track.schema.json",
  "title": "StegLearn Canonical Caption Track",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","lesson_id","lesson_version","language","caption_source","entries","translation_policy"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "lesson_id": {"type":"string","minLength":1},
    "lesson_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "language": {"type":"string","minLength":2},
    "caption_source": {"const":"CANONICAL_SCENE_CAPTIONS"},
    "entries": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["scene_id","order","text"],"properties":{"scene_id":{"type":"string"},"order":{"type":"integer","minimum":1},"text":{"type":"string","minLength":1}}}},
    "translation_policy": {"type":"object","additionalProperties":false,"required":["translations_must_preserve_claim_semantics","machine_translation_requires_review_for_canonical_publication"],"properties":{"translations_must_preserve_claim_semantics":{"const":true},"machine_translation_requires_review_for_canonical_publication":{"const":true}}}
  }
}
