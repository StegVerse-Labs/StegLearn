{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/StegLearn/schemas/lesson-scene.schema.json",
  "title": "StegLearn Lesson Scene Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","lesson_id","lesson_version","visual_grammar","scenes"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "lesson_id": {"type":"string","minLength":1},
    "lesson_version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "visual_grammar": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "scenes": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["order","scene_id","claim_ids","caption","narration","visual","do_not_imply"],"properties":{"order":{"type":"integer","minimum":1},"scene_id":{"type":"string","minLength":1},"claim_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"caption":{"type":"string","minLength":1},"narration":{"type":"string","minLength":1},"visual":{"type":"object","additionalProperties":false,"required":["kind","instruction"],"properties":{"kind":{"type":"string","enum":["DIAGRAM","LIST_DIAGRAM","COMPARISON","FLOW","CHECKPOINT","TEXT","STATIC_IMAGE"]},"instruction":{"type":"string","minLength":1}}},"do_not_imply":{"type":"array","items":{"type":"string","minLength":1}}}}}
  }
}
