{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/StegLearn/schemas/video-lesson.schema.json",
  "title": "StegLearn Canonical Video Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","lesson_id","module_id","version","title","difficulty","estimated_duration_minutes","learning_objectives","canonical_sources","claims","renderer_policy","checkpoint","receipt_evidence_objectives","version_provenance"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "lesson_id": {"type":"string","minLength":1},
    "module_id": {"type":"string","minLength":1},
    "version": {"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type":"string","minLength":1},
    "difficulty": {"type":"string","enum":["FOUNDATION","INTERMEDIATE","ADVANCED"]},
    "estimated_duration_minutes": {"type":"integer","minimum":1},
    "learning_objectives": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "canonical_sources": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["source_id","repository","path","authority_scope","status"],"properties":{"source_id":{"type":"string"},"repository":{"type":"string"},"path":{"type":"string"},"authority_scope":{"type":"string"},"status":{"type":"string"}}}},
    "claims": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["claim_id","source_id","text"],"properties":{"claim_id":{"type":"string"},"source_id":{"type":"string"},"text":{"type":"string","minLength":1}}}},
    "renderer_policy": {"type":"object","additionalProperties":false,"required":["siteflow_target","captions_are_canonical","renderer_may_paraphrase_claims","renderer_may_invent_claims","renderer_may_change_authority_semantics","generated_content_is_authoritative"],"properties":{"siteflow_target":{"type":"string"},"captions_are_canonical":{"const":true},"renderer_may_paraphrase_claims":{"const":false},"renderer_may_invent_claims":{"const":false},"renderer_may_change_authority_semantics":{"const":false},"generated_content_is_authoritative":{"const":false}}},
    "checkpoint": {"type":"object","additionalProperties":false,"required":["question","choices","correct_choice_index","evidence_objective"],"properties":{"question":{"type":"string"},"choices":{"type":"array","minItems":2,"items":{"type":"string"}},"correct_choice_index":{"type":"integer","minimum":0},"evidence_objective":{"type":"string"}}},
    "receipt_evidence_objectives": {"type":"array","minItems":1,"items":{"type":"string"}},
    "version_provenance": {"type":"object","additionalProperties":false,"required":["architecture_as_of","source_change_requires_lesson_review","prior_versions_preserved"],"properties":{"architecture_as_of":{"type":"string"},"source_change_requires_lesson_review":{"const":true},"prior_versions_preserved":{"const":true}}}
  }
}
