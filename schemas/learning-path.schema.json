{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StegVerse-Labs/StegLearn/schemas/learning-path.schema.json",
  "title": "StegLearn Learning Path",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "learning_path_id",
    "version",
    "title",
    "summary",
    "audience",
    "equipment",
    "stages",
    "subject_mappings",
    "non_capture_note"
  ],
  "properties": {
    "learning_path_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_age_guidance", "adult_supervision_required", "adult_only_tasks"],
      "properties": {
        "minimum_age_guidance": { "type": "integer", "minimum": 0 },
        "adult_supervision_required": { "type": "boolean" },
        "adult_only_tasks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "optional": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "title", "activity_types", "objectives", "safety_gate", "evidence"],
        "properties": {
          "stage_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "activity_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "question",
                "build",
                "observation",
                "experiment",
                "story",
                "drawing",
                "video",
                "game-design",
                "reading",
                "outdoor-walk",
                "conversation",
                "music-and-mood",
                "logic-puzzle",
                "physical-challenge",
                "care-task",
                "code",
                "research",
                "reflection"
              ]
            }
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "safety_gate": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "subject_mappings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "non_capture_note": { "type": "string", "minLength": 1 }
  }
}
